generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  BigInt               @id @default(autoincrement())
  email               String               @unique @db.VarChar(255)
  /// OAuth users (Google) may not have a password; email/password login still requires this to be set.
  passwordHash        String?              @map("password_hash") @db.VarChar(255)
  name                String               @db.VarChar(100)
  avatarUrl           String?              @map("avatar_url") @db.VarChar(500)
  role                Role                 @default(USER)
  emailVerified       Boolean              @default(false) @map("email_verified")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  image               String?              @db.VarChar(500)
  stripeCustomerId    String?              @map("stripe_customer_id") @db.VarChar(255)
  lineUserId          String?              @map("line_user_id") @db.VarChar(255)
  accounts            Account[]
  artist              Artist?
  blogs               Blog[]
  bookings            Booking[]
  emailVerifications  EmailVerification[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  viewHistories       ViewHistory[]
  favorites           Favorite[]
  reviews             Review[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Artist {
  id                 BigInt                   @id @default(autoincrement())
  userId             BigInt                   @unique @map("user_id")
  displayName        String                   @map("display_name") @db.VarChar(100)
  bio                String?
  areaId             BigInt                   @map("area_id")
  profileImgUrl      String?                  @map("profile_img_url") @db.VarChar(500)
  medicalLicenseUrl  String?                  @map("medical_license_url") @db.VarChar(500)
  artmakeDiplomaUrl  String?                  @map("artmake_diploma_url") @db.VarChar(500)
  clinicName         String?                  @map("clinic_name") @db.VarChar(100)
  clinicAddress      String?                  @map("clinic_address") @db.VarChar(255)
  businessHours      String?                  @map("business_hours") @db.VarChar(255)
  instagramUrl       String?                  @map("instagram_url") @db.VarChar(255)
  twitterUrl         String?                  @map("twitter_url") @db.VarChar(255)
  lineUrl            String?                  @map("line_url") @db.VarChar(255)
  yearsOfExperience  Int?                     @map("years_of_experience") @db.SmallInt
  registrationStatus ArtistRegistrationStatus @default(PROVISIONAL) @map("registration_status")
  isPublished        Boolean                  @default(false) @map("is_published")
  viewCount          BigInt                   @default(0) @map("view_count")
  rankingScore       Decimal                  @default(0) @map("ranking_score") @db.Decimal(10, 4)
  isSponsored        Boolean                  @default(false) @map("is_sponsored")
  priorityRank       Int                      @default(0) @map("priority_rank") @db.SmallInt
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz(6)
  skills             ArtistSkill[]
  subscriptions      ArtistSubscription[]
  area               Area                     @relation(fields: [areaId], references: [id])
  user               User                     @relation(fields: [userId], references: [id])
  availability       Availability[]
  bookingFees        BookingFee[]
  bookings           Booking[]
  cases              Case[]
  invoices           Invoice[]
  menus              Menu[]
  reviews            Review[]

  @@index([areaId], map: "idx_artists_area")
  @@index([isPublished], map: "idx_artists_published")
  @@index([rankingScore(sort: Desc)], map: "idx_artists_ranking")
  @@index([isPublished, deletedAt, isSponsored, priorityRank, rankingScore(sort: Desc)], map: "idx_artists_sponsorship_ranking")
  @@index([isPublished, deletedAt, isSponsored, priorityRank, createdAt(sort: Desc)], map: "idx_artists_sponsorship_created")
  @@map("artists")
}

model ArtistSkill {
  id         BigInt   @id @default(autoincrement())
  artistId   BigInt   @map("artist_id")
  categoryId BigInt   @map("category_id")
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  artist     Artist   @relation(fields: [artistId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([artistId, categoryId])
  @@map("artist_skills")
}

model Area {
  id         BigInt   @id @default(autoincrement())
  prefecture String   @db.VarChar(20)
  city       String?  @db.VarChar(50)
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  artists    Artist[]

  @@index([prefecture], map: "idx_areas_prefecture")
  @@map("areas")
}

model Category {
  id             BigInt         @id @default(autoincrement())
  name           String         @unique @db.VarChar(50)
  slug           String         @unique @db.VarChar(50)
  sortOrder      Int            @default(0) @map("sort_order") @db.SmallInt
  isActive       Boolean        @default(true) @map("is_active")
  artistSkills   ArtistSkill[]
  blogCategories BlogCategory[]
  cases          Case[]
  menus          Menu[]
  techniques     Technique[]

  @@map("categories")
}

model Technique {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt   @map("category_id")
  name       String   @unique @db.VarChar(100)
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  cases      Case[]
  category   Category @relation(fields: [categoryId], references: [id])

  @@map("techniques")
}

model Case {
  id           BigInt     @id @default(autoincrement())
  artistId     BigInt     @map("artist_id")
  categoryId   BigInt     @map("category_id")
  techniqueId  BigInt?    @map("technique_id")
  menuId       BigInt?    @map("menu_id")
  title        String     @db.VarChar(200)
  description  String
  beforeImgUrl String     @map("before_img_url") @db.VarChar(500)
  afterImgUrl  String     @map("after_img_url") @db.VarChar(500)
  sessionCount Int?       @map("session_count") @db.SmallInt
  downtimeDays Int?       @map("downtime_days") @db.SmallInt
  downtimeNote String?    @map("downtime_note") @db.VarChar(255)
  isPublished  Boolean    @default(false) @map("is_published")
  viewCount    BigInt     @default(0) @map("view_count")
  rankingScore Decimal    @default(0) @map("ranking_score") @db.Decimal(10, 4)
  isSponsored  Boolean    @default(false) @map("is_sponsored")
  priorityRank Int        @default(0) @map("priority_rank") @db.SmallInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  artist       Artist     @relation(fields: [artistId], references: [id])
  category     Category   @relation(fields: [categoryId], references: [id])
  technique    Technique? @relation(fields: [techniqueId], references: [id])
  menu         Menu?      @relation(fields: [menuId], references: [id])

  @@index([artistId], map: "idx_cases_artist")
  @@index([categoryId], map: "idx_cases_category")
  @@index([isPublished], map: "idx_cases_published")
  @@index([rankingScore(sort: Desc)], map: "idx_cases_ranking")
  @@index([categoryId, artistId], map: "idx_cases_search")
  @@index([title, description], map: "idx_cases_trgm")
  @@index([isPublished, deletedAt, isSponsored, priorityRank, rankingScore(sort: Desc)], map: "idx_cases_sponsorship_ranking")
  @@index([isPublished, deletedAt, isSponsored, priorityRank, createdAt(sort: Desc)], map: "idx_cases_sponsorship_created")
  @@map("cases")
}

model Menu {
  id          BigInt    @id @default(autoincrement())
  artistId    BigInt    @map("artist_id")
  categoryId  BigInt    @map("category_id")
  name        String    @db.VarChar(200)
  description String?
  price       Int?
  durationMin Int       @default(60) @map("duration_min") @db.SmallInt
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order") @db.SmallInt
  bookings    Booking[]
  cases       Case[]
  artist      Artist    @relation(fields: [artistId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])

  @@index([artistId], map: "idx_menus_artist")
  @@map("menus")
}

model Availability {
  id                 BigInt             @id @default(autoincrement())
  artistId           BigInt             @map("artist_id")
  date               DateTime           @db.Date
  startTime          DateTime           @map("start_time") @db.Time(6)
  endTime            DateTime           @map("end_time") @db.Time(6)
  status             AvailabilityStatus @default(AVAILABLE)
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Extra slots blocked by a multi-hour menu booking (§8.2); cleared on cancel.
  blockedByBookingId BigInt?            @map("blocked_by_booking_id")
  artist             Artist             @relation(fields: [artistId], references: [id])
  blockedByBooking   Booking?           @relation("BookingBlockedSlots", fields: [blockedByBookingId], references: [id])
  booking            Booking?           @relation("BookingPrimarySlot")

  @@unique([artistId, date, startTime], map: "uq_availability_artist_slot")
  @@index([artistId, date], map: "idx_availability_artist_date")
  @@index([status], map: "idx_availability_status")
  @@index([blockedByBookingId], map: "idx_availability_blocked_by_booking")
  @@map("availability")
}

model Booking {
  id                    BigInt         @id @default(autoincrement())
  userId                BigInt         @map("user_id")
  artistId              BigInt         @map("artist_id")
  availabilityId        BigInt         @unique @map("availability_id")
  menuId                BigInt?        @map("menu_id")
  status                BookingStatus  @default(PENDING)
  userNote              String?        @map("user_note")
  artistNote            String?        @map("artist_note")
  cancelledBy           String?        @map("cancelled_by") @db.VarChar(20)
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  stripePaymentIntentId String?        @map("stripe_payment_intent_id") @db.VarChar(255)
  blockedSlots          Availability[] @relation("BookingBlockedSlots")
  fee                   BookingFee?
  artist                Artist         @relation(fields: [artistId], references: [id])
  availability          Availability   @relation("BookingPrimarySlot", fields: [availabilityId], references: [id])
  menu                  Menu?          @relation(fields: [menuId], references: [id])
  user                  User           @relation(fields: [userId], references: [id])
  review                Review?

  @@index([userId], map: "idx_bookings_user")
  @@index([artistId], map: "idx_bookings_artist")
  @@index([status], map: "idx_bookings_status")
  @@map("bookings")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  body      String?
  isRead    Boolean  @default(false) @map("is_read")
  refId     BigInt?  @map("ref_id")
  refType   String?  @map("ref_type") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_created")
  @@map("notifications")
}

model Blog {
  id           BigInt         @id @default(autoincrement())
  authorId     BigInt         @map("author_id")
  title        String         @db.VarChar(300)
  slug         String         @unique @db.VarChar(300)
  body         String
  thumbnailUrl String?        @map("thumbnail_url") @db.VarChar(500)
  isPublished  Boolean        @default(false) @map("is_published")
  publishedAt  DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  excerpt      String?        @db.VarChar(400)
  categories   BlogCategory[]
  author       User           @relation(fields: [authorId], references: [id])

  @@index([isPublished, publishedAt(sort: Desc)], map: "idx_blogs_published")
  @@map("blogs")
}

model BlogCategory {
  blogId     BigInt   @map("blog_id")
  categoryId BigInt   @map("category_id")
  blog       Blog     @relation(fields: [blogId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([blogId, categoryId])
  @@map("blog_categories")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    BigInt   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

model EmailVerification {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  token      String    @unique @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_email_verifications_expires")
  @@map("email_verifications")
}

model PasswordResetToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_password_reset_tokens_expires")
  @@map("password_reset_tokens")
}

model ViewHistory {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  sessionKey String?  @map("session_key") @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   BigInt   @map("target_id")
  viewedAt   DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt(sort: Desc)], map: "idx_view_history_user")
  @@index([sessionKey, viewedAt(sort: Desc)], map: "idx_view_history_session")
  @@index([targetType, targetId, viewedAt(sort: Desc)], map: "idx_view_history_dedup")
  @@map("view_history")
}

model RankingScore {
  id           BigInt   @id @default(autoincrement())
  targetType   String   @map("target_type") @db.VarChar(20)
  targetId     BigInt   @map("target_id")
  viewCount    BigInt   @default(0) @map("view_count")
  likeCount    BigInt   @default(0) @map("like_count")
  reviewCount  BigInt   @default(0) @map("review_count")
  reviewAvg    Decimal  @default(0) @map("review_avg") @db.Decimal(3, 2)
  score        Decimal  @default(0) @db.Decimal(10, 4)
  calculatedAt DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)

  @@unique([targetType, targetId])
  @@index([score(sort: Desc)], map: "idx_ranking_scores_score")
  @@map("ranking_scores")
}

model SubscriptionPlan {
  id            BigInt               @id @default(autoincrement())
  planCode      String               @unique @map("plan_code") @db.VarChar(50)
  name          String               @db.VarChar(100)
  monthlyFee    Int                  @map("monthly_fee")
  feeRate       Decimal              @map("fee_rate") @db.Decimal(5, 4)
  maxCases      Int                  @map("max_cases")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  subscriptions ArtistSubscription[]

  @@map("subscription_plans")
}

model ArtistSubscription {
  id        BigInt           @id @default(autoincrement())
  artistId  BigInt           @map("artist_id")
  planId    BigInt           @map("plan_id")
  isTrial   Boolean          @default(false) @map("is_trial")
  startedAt DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  artist    Artist           @relation(fields: [artistId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([artistId], map: "idx_subscriptions_artist")
  @@index([expiresAt], map: "idx_subscriptions_expires")
  @@map("artist_subscriptions")
}

model Invoice {
  id               BigInt        @id @default(autoincrement())
  artistId         BigInt        @map("artist_id")
  periodStart      DateTime      @map("period_start") @db.Date
  periodEnd        DateTime      @map("period_end") @db.Date
  listingFee       Int           @default(0) @map("listing_fee")
  totalBookingFees Int           @default(0) @map("total_booking_fees")
  totalAmount      Int           @default(0) @map("total_amount")
  status           InvoiceStatus @default(DRAFT)
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  fees             BookingFee[]
  artist           Artist        @relation(fields: [artistId], references: [id])

  @@index([artistId, periodStart], map: "idx_invoices_period")
  @@map("invoices")
}

model BookingFee {
  id        BigInt           @id @default(autoincrement())
  artistId  BigInt           @map("artist_id")
  bookingId BigInt           @unique @map("booking_id")
  invoiceId BigInt?          @map("invoice_id")
  menuPrice Int              @map("menu_price")
  feeRate   Decimal          @map("fee_rate") @db.Decimal(5, 4)
  feeAmount Int              @map("fee_amount")
  status    BookingFeeStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  artist    Artist           @relation(fields: [artistId], references: [id])
  booking   Booking          @relation(fields: [bookingId], references: [id])
  invoice   Invoice?         @relation(fields: [invoiceId], references: [id])

  @@index([artistId, status], map: "idx_booking_fees_status")
  @@map("booking_fees")
}

model Account {
  id                BigInt  @id @default(autoincrement())
  userId            BigInt  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  refresh_token_expires_in Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Favorite {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   BigInt   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId], map: "uq_favorite_user_target")
  @@index([userId, targetType, createdAt(sort: Desc)], map: "idx_favorites_user")
  @@map("favorites")
}

model Review {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  artistId  BigInt   @map("artist_id")
  bookingId BigInt   @unique @map("booking_id")
  rating    Int      @db.SmallInt
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
  artist    Artist   @relation(fields: [artistId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([artistId, createdAt(sort: Desc)], map: "idx_reviews_artist")
  @@map("reviews")
}

model HeroBanner {
  id             BigInt   @id @default(autoincrement())
  imageUrl       String   @map("image_url") @db.VarChar(500)
  mobileImageUrl String   @map("mobile_image_url") @db.VarChar(500)
  altText        String?  @map("alt_text") @db.VarChar(255)
  linkUrl        String?  @map("link_url") @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("hero_banners")
}

enum Role {
  USER   @map("user")
  ARTIST @map("artist")
  ADMIN  @map("admin")

  @@map("user_role")
}

enum AvailabilityStatus {
  AVAILABLE @map("available")
  BOOKED    @map("booked")
  BLOCKED   @map("blocked")

  @@map("availability_status")
}

enum BookingStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  CANCELLED @map("cancelled")
  COMPLETED @map("completed")

  @@map("booking_status")
}

enum InvoiceStatus {
  DRAFT   @map("draft")
  SENT    @map("sent")
  PAID    @map("paid")
  OVERDUE @map("overdue")

  @@map("invoice_status")
}

enum BookingFeeStatus {
  PENDING  @map("pending")
  INVOICED @map("invoiced")
  PAID     @map("paid")
  WAIVED   @map("waived")

  @@map("booking_fee_status")
}

enum ArtistRegistrationStatus {
  PROVISIONAL @map("provisional")
  APPROVED    @map("approved")
  REJECTED    @map("rejected")

  @@map("artist_registration_status")
}
