DATABASE_URL="postgresql://makele_user:your_password@localhost:5432/makele_db?schema=public"

# Backend data source switch
# - true: use in-memory mock Prisma data
# - false: use real DATABASE_URL
USE_MOCK_PRISMA="true"

# Frontend-only mock UI switch (favorites/points/coupons etc. while backend is in progress)
NEXT_PUBLIC_USE_MOCK_UI="true"

# Demo role switcher and demo auth endpoints
NEXT_PUBLIC_ENABLE_DEMO_AUTH="false"
ENABLE_DEMO_AUTH="false"

# Required by current auth implementation
JWT_SECRET="your-jwt-secret-key-change-in-production"

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@makele.jp"
SMTP_PASS="your-smtp-password"
SMTP_FROM="MAKELE <noreply@makele.jp>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MAKELE"

UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=5

CRON_SECRET="your-cron-secret-key-change-in-production"

# Set to true only after GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and NEXTAUTH_* are configured.
NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED="false"

# NextAuth (required when Google sign-in is enabled)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Google OAuth (required when Google sign-in is enabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Payment Integration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
