{
  "name": "salon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "USE_MOCK_PRISMA=true NEXT_PUBLIC_USE_MOCK_UI=true NEXT_PUBLIC_ENABLE_DEMO_AUTH=true ENABLE_DEMO_AUTH=true next dev",
